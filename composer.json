{
    "name": "paymfi/paymfi-php",
    "description": "PHP client for the PayMfi eWallet & Payments API: signed requests, hosted checkout, server-side verification and webhook signature checks.",
    "type": "library",
    "license": "MIT",
    "keywords": ["paymfi", "payments", "ewallet", "mfi", "sacco", "sdk", "api"],
    "homepage": "https://paymfi.com",
    "require": {
        "php": "^8.1",
        "ext-curl": "*",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5 || ^11.5 || ^12.0"
    },
    "autoload": {
        "psr-4": {
            "PayMfi\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "PayMfi\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable"
}
